        sTXSection = xmlCurrentInDoc.getMethodParameterText("TXSection", True)

        xmlRXSection = xmlCurrentInDoc.getMethodParameterNode("RXSection", True)

        xmlRXSectionPassCount = xmlRXSection.OwnerDocument.CreateAttribute("pass")
        xmlRXSectionPassCount.InnerText = nPassCount

        xmlRXSectionLineCount = xmlRXSection.OwnerDocument.CreateAttribute("line")

        xmlRXSectionLineCount.InnerText = nPassCount

        xmlPrintDocuments = xmlCurrentInDoc.OwnerDocument.CreateElement(sTXSection)


        Do
            oDocument = New TCSRTFDocument(sTemplate)

            nPassCount += 1
            xmlRXSectionPassCount.InnerText = nPassCount
            xmlRXSectionLineCount.InnerText = nEndLine

            For Each xmlSubNode In xmlRXSection.ChildNodes
                xmlSubNode.Attributes.SetNamedItem(xmlRXSectionPassCount)
                xmlSubNode.Attributes.SetNamedItem(xmlRXSectionLineCount)
            Next

            bResult = RTFMergeDocument(oDocument, xmlRXSection, sStartLine)
            nEndLine = sStartLine
            sStartLine = 0


            If bResult = RTFMergeDocumentResult.Merged Then
                'Start of IR 261345
                'Dim oTempFiles As New CodeDom.Compiler.TempFileCollection()
                'sTempFile = oTempFiles.AddExtension("rtf", True)
                If Not (Directory.Exists(System.AppDomain.CurrentDomain.BaseDirectory & "RTFTEMP")) Then
                    Directory.CreateDirectory(System.AppDomain.CurrentDomain.BaseDirectory & "RTFTEMP")
                End If
                Dim oTempRTFFiles As New CodeDom.Compiler.TempFileCollection(System.AppDomain.CurrentDomain.BaseDirectory & "RTFTEMP", False)
                sTempFile = oTempRTFFiles.AddExtension("rtf", True)
                'End of IR 261345
                oDocument.Save(sTempFile)

                Try
                    If sTemplateTemp = "ATM_CashReplenishment.rtf" Or sTemplateTemp = "CashPoint_CashReplenishment.rtf" Or sTemplateTemp = "CashPoint_CashReplenishmentCorr.rtf" Then
                        'Start of IR 20090073
                        'xmlComponentProperty.Load(System.AppDomain.CurrentDomain.BaseDirectory & "\Receipts.config")
                        Dim goodSettingsws As XmlReaderSettings = New XmlReaderSettings()
                        goodSettingsws.DtdProcessing = DtdProcessing.Ignore
                        goodSettingsws.XmlResolver = Nothing
                        goodSettingsws.ValidationType = ValidationType.Schema
                        goodSettingsws.Schemas = New XmlSchemaSet()
