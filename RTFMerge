    Public Function GetGroupsByCommand(ByVal Command As String) As Collection
        Dim oChildNode As RTFNode
        Dim oChildGroupsNode As RTFNode
        Dim colChildGroups As Collection
        Dim colGroups As New Collection()

        For Each oChildNode In Children
            Select Case oChildNode.Type
                Case "group"
                    Dim oChildGroup As RTFGroup = oChildNode
                    colChildGroups = oChildGroup.GetGroupsByCommand(Command)

                    For Each oChildGroupsNode In colChildGroups
                        colGroups.Add(oChildGroupsNode)
                    Next

                Case "command"
                    If oChildNode.outerRTF.Trim.Equals(Command) Then
                        colGroups.Add(Me)
                    End If

            End Select
        Next

        Return colGroups

