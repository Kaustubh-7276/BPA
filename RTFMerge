                End Try

                If (sSaveReport = "true") Then
                    sSaveTemplatePath = System.AppDomain.CurrentDomain.BaseDirectory & "SavedReports"
                    sTellerNo = Convert.ToString(xmlCurrentInDoc.getMethodParameterText("TellerNo", True))
                    Dim nTellerNo As Int32 = Convert.ToInt32(sTellerNo)
                    Dim Is_Scab As String
                    Try
                        Is_Scab = xmlCurrentInDoc.body.SelectSingleNode("//userInfo/IS_SCAB").InnerText
                    Catch
                        Is_Scab = ""
                    End Try

                    If Is_Scab = "Y" Then
                        sVaultTeller = vTellerNo
                    End If
                    sTellerNo = "Teller " & sTellerNo

                    sTime = TimeString
                    sDate = sDate.Replace("/", "-")
                    sTime = sTime.Replace(":", "-")
                    sSaveTemplatePath = sSaveTemplatePath & "\" & sDate & "\" & sAttribute
                    Directory.CreateDirectory(sSaveTemplatePath)

                    Dim sRepName As String
                    If sCustomNameFLag = "true" Then
                        Try
                            sRepName = xmlCurrentInDoc.body.SelectSingleNode("screenData").SelectSingleNode("RepName").InnerText()
                        Catch
                            sRepName = ""
                        End Try


                        If sRepName = "" Then
                            If Is_Scab = "Y" Then
                                If sVaultTeller = "" Or sVaultTeller = "null" Then
                                    sSaveFileName = sTellerNo & ", " & sTime & ".doc"
                                Else
                                    If (sTranNo = ("RPTCash1")) Or (sTranNo = ("RPTCash12")) Or (sTranNo = ("RPTCash13")) Or (sTranNo = ("RPTCash7")) Or (sTranNo = ("RPTCash8")) Or (sTranNo = ("RPTCash81")) Or (sTranNo = ("RPTCash82")) Or (sTranNo = ("RPTCash9")) Or (sTranNo = ("RPTCash10")) Then
                                        sSaveFileName = sVaultTeller & "_" & sTellerNo & ", " & sTime & ".doc"
                                    Else
                                        sSaveFileName = sTellerNo & ", " & sTime & ".doc"
                                    End If
                                End If
                            Else
                                sSaveFileName = sTellerNo & ", " & sTime & ".doc"
                            End If
                        Else
                            sSaveFileName = sRepName & "-" & xmlPrintDocuments.ChildNodes.Count + 1 & ".doc"
                        End If

                    Else
                        If Is_Scab = "Y" Then
                            If sVaultTeller = "" Or sVaultTeller = "null" Then
                                sSaveFileName = sTellerNo & ", " & sTime & ".doc"
                            Else
                                If (sTranNo = ("RPTCash1")) Or (sTranNo = ("RPTCash12")) Or (sTranNo = ("RPTCash13")) Or (sTranNo = ("RPTCash7")) Or (sTranNo = ("RPTCash8")) Or (sTranNo = ("RPTCash81")) Or (sTranNo = ("RPTCash82")) Or (sTranNo = ("RPTCash9")) Or (sTranNo = ("RPTCash10")) Then
                                    sSaveFileName = sVaultTeller & "_" & sTellerNo & ", " & sTime & ".doc"
                                Else
                                    sSaveFileName = sTellerNo & ", " & sTime & ".doc"
                                End If
                            End If
                        Else
                            sSaveFileName = sTellerNo & ", " & sTime & ".doc"
                        End If
                    End If

                    sSaveTemplatePath = sSaveTemplatePath & "\" & sSaveFileName
                    'Start of IR 20090073
                    Dim pattern As String = "^(([a-zA-Z]\:)|(\\))(\\{1}|((\\{1})[^\\]([^/:*?<>""|]*))+)$"   'For Path
                    Dim validate As Owasp.Esapi.Encoder = New Owasp.Esapi.Encoder()
                    sSaveTemplatePath = validate.Canonicalize(sSaveTemplatePath)
                    Dim mPath As Match = Regex.Match(sSaveTemplatePath, pattern, RegexOptions.IgnorePatternWhitespace)
                    If (mPath.Success) Then
                        sSaveTemplatePath = mPath.Groups(0).Value.ToString()
                    End If
                    'End of IR 20090073
                    oDocument.Save(sSaveTemplatePath)
                End If

                xmlPrintDocument = xmlCurrentInDoc.OwnerDocument.CreateElement(sTXCollection)

                xmlPrintDocument.InnerXml = "<fileName>" & sTempFile & "</fileName>"

                Try
                    sTitle = oDocument.SelectSingleNode("\title").Parent.Children.Item(2).RTF
                Catch e As Exception
                    sTitle = "Unknown Document"
                End Try

                sTitle += "  : Page " & xmlPrintDocuments.ChildNodes.Count + 1

                xmlPrintDocument.InnerXml += "<title>" & sTitle & "</title>"
                xmlPrintDocument.InnerXml += "<LineNo>" & nEndLine.ToString & "</LineNo>"

                xmlPrintDocuments.AppendChild(xmlPrintDocument)
            End If


        Loop Until bResult = RTFMergeDocumentResult.NoMerge

        If xmlPrintDocuments.ChildNodes.Count = 0 Then
            Throw New Exception("No Pages to Print")
        End If

        Return xmlPrintDocuments
    End Function

    Private Function RTFMergeDocument(ByVal RTFDocument As TCSRTFDocument, ByVal xmlRXSection As Xml.XmlNode, ByRef StartRow As Integer) As RTFMergeDocumentResult
        Dim oTemplateFields As Collection
        Dim oTemplateField As RTFNode

        Dim oSkipFields As Collection

        Dim oFieldGroup As RTFFieldGroup
        Dim sInstruction As String
        Dim bValidInstruction As Boolean

        Dim oMessageFields As Xml.XmlNodeList
        Dim oMessageField As Xml.XmlNode
        Dim oMessageFieldUsed As Xml.XmlNode
        Dim oMessageFieldUsedNew As Xml.XmlNode

        Dim oResult As RTFMergeDocumentResult = RTFMergeDocumentResult.NoMerge
        Dim oStartLine As New TCSLineCheck()

        oStartLine.StartLine = StartRow

        oMessageFieldUsedNew = xmlRXSection.OwnerDocument.CreateAttribute(MERGER_FIELD_USED)
        oMessageFieldUsedNew.InnerText = "True"

        oTemplateFields = RTFDocument.GetGroupsByCommand("\field")

        For Each oTemplateField In oTemplateFields
            oFieldGroup = New RTFFieldGroup(oTemplateField)
            sInstruction = Trim(oFieldGroup.FieldInstruction)
            If sInstruction.Length > 0 Then

                oFieldGroup.FieldResult = ""

                If sInstruction.IndexOf(MERGER_FIELD_ATT_USED) > 0 Then
                    Try
                        oMessageFields = xmlRXSection.SelectNodes(sInstruction)
                        bValidInstruction = True
                    Catch e As Exception
                        bValidInstruction = False
                    End Try
                Else
                    Try
                        oMessageFields = xmlRXSection.SelectNodes(sInstruction + "[not(" + MERGER_FIELD_ATT_USED + "= True" + ")]")
                        bValidInstruction = True
                    Catch e As Exception
                        bValidInstruction = False
                    End Try
                End If


                If oStartLine.Check(sInstruction) And bValidInstruction Then
                    For Each oMessageField In oMessageFields

                        If IsXMLNodePrintable(oMessageField) Then
                            oMessageFieldUsed = oMessageField.Attributes.GetNamedItem(MERGER_FIELD_USED)

                            If oMessageFieldUsed Is Nothing Then
                                oFieldGroup.FieldResult = RTrim(oMessageField.InnerText)
                                oMessageField.Attributes.SetNamedItem(oMessageFieldUsedNew)
                                oResult = RTFMergeDocumentResult.Merged
                                StartRow = oStartLine.LineNo
                                Exit For
                            Else
                                If oMessageFieldUsed.InnerText = "False" Then
                                    oFieldGroup.FieldResult = RTrim(oMessageField.InnerText)
                                    oMessageFieldUsed.InnerText = "True"
                                    oResult = RTFMergeDocumentResult.Merged
                                    StartRow = oStartLine.LineNo
                                    Exit For
                                End If
                            End If
                        End If
                    Next
                End If
            End If
        Next
        Return oResult

    End Function

    Private Function IsXMLNodePrintable(ByVal oMessageField As Xml.XmlNode) As Boolean

        If oMessageField.ChildNodes.Count = 1 Then
            If oMessageField.ChildNodes(0).NodeType = Xml.XmlNodeType.Text Then
                Return True
            Else
                Return False
            End If
        ElseIf oMessageField.ChildNodes.Count = 0 Then
            Return True
        Else
            Return False
        End If

    End Function


