    End Function

    Private Sub GetNextGroup(ByVal CurrentGroup As RTFNode)
        Dim oNewGroup As RTFGroup
        Dim sData As New StringBuilder()

        Do
            msCurrentChar = Chr(mfsTemplate.ReadByte())

            Select Case msCurrentChar
                Case "{"
                    If sData.ToString <> "" Then
                        ParseData(sData.ToString, CurrentGroup)
                        sData.Remove(0, sData.Length)
                    End If

                    oNewGroup = New RTFGroup()
                    CurrentGroup.Add(oNewGroup)
                    GetNextGroup(oNewGroup)

                Case "}"
                    If sData.ToString <> "" Then
                        ParseData(sData.ToString, CurrentGroup)
                        sData.Remove(0, sData.Length)
                    End If

                    Return

                Case Chr(10), Chr(13)

                Case Else
                    sData.Append(msCurrentChar)

            End Select
        Loop While mfsTemplate.Position < mfsTemplate.Length
    End Sub

    Private Sub ParseData(ByVal Data As String, ByVal CurrentGroup As RTFNode)
        Dim sCommands() As String
        Dim sCommandPram() As String
        Dim nCommand As Integer
        Dim nCommandPram As Integer
        Dim bDelimeters(1) As Char

        Dim oNewCommand As RTFCommand
        Dim oNewText As RTFText

        bDelimeters(0) = "\"
        sCommands = Data.Split(bDelimeters)

        If sCommands(0) <> "" Then
            oNewText = New RTFText()
            oNewText.RTF = sCommands(nCommand)
            CurrentGroup.Add(oNewText)
        End If

        For nCommand = 1 To sCommands.Length - 1
            oNewCommand = New RTFCommand()

            Dim sCommandData As String = sCommands(nCommand)

            Dim nPos As Int32 = sCommandData.IndexOf(" ")

            If nPos >= 0 Then
                nPos += 1
                oNewCommand.RTF = sCommandData.Substring(0, nPos)

                CurrentGroup.Add(oNewCommand)

                If sCommandData.Length > nPos Then
                    oNewText = New RTFText()
                    oNewText.RTF = sCommandData.Substring(nPos)
                    CurrentGroup.Add(oNewText)
                End If
            Else
                oNewCommand.RTF = sCommands(nCommand)
                CurrentGroup.Add(oNewCommand)
            End If
        Next

    End Sub
End Class

Public Class RTFFieldGroup
    Inherits RTFGroup

    Private Const RTF_FIELDINST = "\fldinst"
    Private Const RTF_FIELDINST_MERGEFIELD = "MERGEFIELD"
    Private Const RTF_FIELDINST_MERGEFORMAT = "\* MERGEFORMAT"
    Private Const RTF_FIELDRSLT = "\fldrslt"
    Private Const RTF_FIELDRSLT_AB = "\'ab"
    Private Const RTF_FIELDRSLT_BB = "\'bb"

    Public Sub New(ByVal Group As RTFGroup)
        Dim oNode As RTFNode
        Dim nNode As Integer = 0
        Dim oFieldResultGroup As RTFGroup

        Dim bRemove As Boolean = False
        Dim oNewNode As RTFText

        For Each oNode In Group.Children
            Add(oNode)
        Next

        oFieldResultGroup = SelectSingleNode(RTF_FIELDRSLT).Parent

        Try
            oFieldResultGroup = oFieldResultGroup.SelectSingleNode(RTF_FIELDRSLT_AB).Parent
        Catch e As Exception
            SplitTextFieldFromCommand(oFieldResultGroup)
        End Try

        nNode = 1
        Do While nNode <= oFieldResultGroup.Children.Count
            oNode = oFieldResultGroup.Children.Item(nNode)

            If oNode.Type = "command" Or bRemove Then

                If String.Compare(oNode.RTF, 0, RTF_FIELDRSLT_AB, 0, 4) = 0 Then
                    bRemove = True
                End If
                If bRemove Then
                    If String.Compare(oNode.RTF, 0, RTF_FIELDRSLT_BB, 0, 4) = 0 Then
                        oFieldResultGroup.Children.Remove(nNode)
                        oFieldResultGroup.Children.Add(New RTFText())
                        Exit Do
                    End If
                    oFieldResultGroup.Children.Remove(nNode)
                Else
                    nNode += 1
                End If
            Else
                nNode += 1
            End If
        Loop
    End Sub

    Private Sub SplitTextFieldFromCommand(ByVal oFieldResultGroup As RTFGroup)
        Dim oNode As RTFNode
        Dim nNode As Integer = 0
        Dim oNewNode As RTFText
        Dim nPramPos As Integer

        For nNode = 1 To oFieldResultGroup.Children.Count
            oNode = oFieldResultGroup.Children.Item(nNode)

            Select Case oNode.Type
                Case "group"
                    SplitTextFieldFromCommand(oNode)
                Case "command"
                    nPramPos = oNode.RTF.TrimEnd.IndexOf(" ")

                    If nPramPos > 0 Then
                        oNewNode = New RTFText()
                        oNewNode.RTF = oNode.RTF.Substring(nPramPos)
                        oNode.RTF = oNode.RTF.Substring(1, nPramPos)
                        oFieldResultGroup.Children.Add(oNewNode)
                    End If

                Case "text"

            End Select
        Next
    End Sub

    Public ReadOnly Property FieldInstruction() As String
        Get
            Dim sFieldInst As String
            Dim nFieldInstStartPos As Integer
            Dim nFieldInstEndPos As Integer
            Dim oFieldInst As RTFNode
            Dim oFieldInstGroup As RTFGroup

            oFieldInstGroup = SelectSingleNode(RTF_FIELDINST).Parent
            oFieldInst = oFieldInstGroup.SelectSingleNode(RTF_FIELDINST_MERGEFIELD)

            If oFieldInst Is Nothing Then
                SplitTextFieldFromCommand(oFieldInstGroup)
            End If

            oFieldInst = oFieldInstGroup.SelectSingleNode(RTF_FIELDINST_MERGEFIELD)

            If oFieldInst Is Nothing Then
                sFieldInst = ""
            Else
                sFieldInst = oFieldInst.RTF

                nFieldInstStartPos = sFieldInst.IndexOf(RTF_FIELDINST_MERGEFIELD)

                If nFieldInstStartPos >= 0 Then
                    nFieldInstStartPos += Len(RTF_FIELDINST_MERGEFIELD)
                    nFieldInstEndPos = sFieldInst.IndexOf(Chr(34))

                    If nFieldInstEndPos > 0 Then
                        sFieldInst = sFieldInst.Substring(nFieldInstStartPos, (nFieldInstEndPos - nFieldInstStartPos))
                    Else
                        sFieldInst = sFieldInst.Substring(nFieldInstStartPos)
                    End If
                Else
                    sFieldInst = ""
                End If
            End If

            sFieldInst = sFieldInst.Replace("_", "/")

            Return sFieldInst.Trim
        End Get
    End Property

    Public Property FieldResult() As String
        Get
            Dim oFieldResultGroup As RTFGroup
            Dim oFieldResult As RTFText
            Dim nFieldResult As Int32
            Dim sFieldResult As String

            Try
                oFieldResultGroup = SelectSingleNode(RTF_FIELDRSLT).Parent
                oFieldResult = GetFieldResultNode(oFieldResultGroup)

                Return oFieldResult.RTF
            Catch e As Exception
                Return ""
            End Try
        End Get

        Set(ByVal Value As String)
            Dim oFieldResultGroup As RTFGroup
            Dim oFieldResult As RTFText
            Dim nFieldResult As Int32
            Dim sFieldResult As String
            Dim sNewFieldResult As String

            Try
                oFieldResultGroup = SelectSingleNode(RTF_FIELDRSLT).Parent
                oFieldResult = GetFieldResultNode(oFieldResultGroup)

                oFieldResult.RTF = Value
            Catch e As Exception
            End Try
        End Set
    End Property

    Private Function GetFieldResultNode(ByVal oFieldResultGroup As RTFGroup) As RTFText
        Dim oFieldResult As RTFNode

        For Each oFieldResult In oFieldResultGroup.Children
            Select Case oFieldResult.Type
                Case "group"
                    Return GetFieldResultNode(oFieldResult)
                Case "text"
                    Return oFieldResult
            End Select
        Next
    End Function
End Class

