    Public Overridable ReadOnly Property outerRTF() As String
        Get
            Return msRTF
        End Get
    End Property

    Public Overridable Property RTF() As String
        Get
            Dim oSubGroup As RTFNode

            Dim sRTF As New Text.StringBuilder(msRTF)

            For Each oSubGroup In Children
                sRTF.Append(oSubGroup.RTF)
            Next

            Return sRTF.ToString
        End Get

        Set(ByVal Value As String)
            msRTF = Value
        End Set
    End Property

    Public Overridable ReadOnly Property Children() As Collection
        Get
            Return msChildren
        End Get
    End Property

    Public Overridable ReadOnly Property Parent() As RTFNode
        Get
            Return msParent
        End Get
    End Property

    Public Sub Add(ByVal NodesChild As RTFNode)
        NodesChild.msParent = Me
        msChildren.Add(NodesChild)
    End Sub

    Public Overridable Function SelectNodes(ByVal Value As String) As Collection
        Dim colNodes As New Collection()
        Dim oChildNode As RTFNode
        Dim colChildNodes As Collection
        Dim oChildNodesNode As RTFNode

        If RTF = Value Then
            colNodes.Add(Me)
        End If

        For Each oChildNode In Children
            colChildNodes = oChildNode.SelectNodes(Value)

            For Each oChildNodesNode In colChildNodes
                colNodes.Add(oChildNodesNode)
            Next
        Next

        Return colNodes

    End Function

    Public Overridable Function SelectSingleNode(ByVal Value As String) As RTFNode
        Dim oNode As RTFNode
        Dim oChildNode As RTFNode

        Try

            If String.Compare(outerRTF.Trim, 0, Value, 0, Value.Length) = 0 Then
                Return Me
            End If

            For Each oChildNode In Children
                oNode = oChildNode.SelectSingleNode(Value)

                If Not oNode Is Nothing Then
                    Exit For
                End If
            Next
        Catch e As Exception
            Throw e
        End Try

        Return oNode

    End Function
End Class
