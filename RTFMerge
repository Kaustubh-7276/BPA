    Public Sub Save(ByVal TempFile As String)
        Dim sRTF As String
        'Start of IR 20090073
        Dim pattern As String = "^(([a-zA-Z]\:)|(\\))(\\{1}|((\\{1})[^\\]([^/:*?<>""|]*))+)$"   'For Path
        TempFile = validate.Canonicalize(TempFile)
        Dim mPath As Match = Regex.Match(TempFile, pattern, RegexOptions.IgnorePatternWhitespace)
        If (mPath.Success) Then
            TempFile = mPath.Groups(0).Value.ToString()
        End If
        'End of IR 20090073
        Dim oTempFile As StreamWriter = File.CreateText(TempFile)
        sRTF = moRTFDocument.RTF
        oTempFile.Write(sRTF)
