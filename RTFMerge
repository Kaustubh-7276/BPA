        Dim bValidInstruction As Boolean

        Dim oMessageFields As Xml.XmlNodeList
        Dim oMessageField As Xml.XmlNode
        Dim oMessageFieldUsed As Xml.XmlNode
        Dim oMessageFieldUsedNew As Xml.XmlNode

        Dim oResult As RTFMergeDocumentResult = RTFMergeDocumentResult.NoMerge
        Dim oStartLine As New TCSLineCheck()

        oStartLine.StartLine = StartRow

        oMessageFieldUsedNew = xmlRXSection.OwnerDocument.CreateAttribute(MERGER_FIELD_USED)
        oMessageFieldUsedNew.InnerText = "True"

        oTemplateFields = RTFDocument.GetGroupsByCommand("\field")

        For Each oTemplateField In oTemplateFields
            oFieldGroup = New RTFFieldGroup(oTemplateField)
            sInstruction = Trim(oFieldGroup.FieldInstruction)
            If sInstruction.Length > 0 Then

                oFieldGroup.FieldResult = ""

                If sInstruction.IndexOf(MERGER_FIELD_ATT_USED) > 0 Then
                    Try
                        oMessageFields = xmlRXSection.SelectNodes(sInstruction)
                        bValidInstruction = True
                    Catch e As Exception
                        bValidInstruction = False
                    End Try
                Else
                    Try
                        oMessageFields = xmlRXSection.SelectNodes(sInstruction + "[not(" + MERGER_FIELD_ATT_USED + "= True" + ")]")
                        bValidInstruction = True
                    Catch e As Exception
                        bValidInstruction = False
                    End Try
                End If


                If oStartLine.Check(sInstruction) And bValidInstruction Then
                    For Each oMessageField In oMessageFields

                        If IsXMLNodePrintable(oMessageField) Then
                            oMessageFieldUsed = oMessageField.Attributes.GetNamedItem(MERGER_FIELD_USED)

                            If oMessageFieldUsed Is Nothing Then
                                oFieldGroup.FieldResult = RTrim(oMessageField.InnerText)
                                oMessageField.Attributes.SetNamedItem(oMessageFieldUsedNew)
                                oResult = RTFMergeDocumentResult.Merged
                                StartRow = oStartLine.LineNo
                                Exit For
                            Else
                                If oMessageFieldUsed.InnerText = "False" Then
                                    oFieldGroup.FieldResult = RTrim(oMessageField.InnerText)
                                    oMessageFieldUsed.InnerText = "True"
                                    oResult = RTFMergeDocumentResult.Merged
                                    StartRow = oStartLine.LineNo
                                    Exit For
                                End If
                            End If
                        End If
                    Next
                End If
            End If
        Next
        Return oResult

    End Function

    Private Function IsXMLNodePrintable(ByVal oMessageField As Xml.XmlNode) As Boolean

        If oMessageField.ChildNodes.Count = 1 Then
            If oMessageField.ChildNodes(0).NodeType = Xml.XmlNodeType.Text Then
                Return True
            Else
                Return False
            End If
        ElseIf oMessageField.ChildNodes.Count = 0 Then
            Return True
        Else
            Return False
        End If

    End Function


End Class



Friend Class TCSLineCheck
    Private mcolFields As New Collection()
    Private mnStartLine As Integer
    Private mnEndLine As Integer

    Public ReadOnly Property LineNo() As Integer
        Get
            Return mnEndLine
        End Get
    End Property

    Public Property StartLine() As Integer
        Get
            Return mnStartLine
        End Get
        Set(ByVal Value As Integer)
            mnStartLine = Value
        End Set
    End Property

    Public Function Check(ByVal Field As String) As Boolean
        Dim oCurrentLine As TCSFieldLine

        Try
            oCurrentLine = mcolFields.Item(Field)
        Catch e As Exception
            oCurrentLine = New TCSFieldLine()
            mcolFields.Add(oCurrentLine, Field)
        End Try

        oCurrentLine.LineNumber += 1

        If oCurrentLine.LineNumber <= mnStartLine Then
            Return False
        Else
            If mnEndLine < oCurrentLine.LineNumber Then
                mnEndLine = oCurrentLine.LineNumber
            End If

            Return True
        End If

    End Function
End Class

Friend Class TCSFieldLine
    Private mnLineNumber As Integer = 1

    Public Property LineNumber() As Integer
        Get
            Return mnLineNumber
        End Get
        Set(ByVal Value As Integer)
            mnLineNumber = Value
        End Set
    End Property
End Class
